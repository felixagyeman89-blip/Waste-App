{
    "name": "Payment",
    "type": "object",
    "properties": {
      "pickup_id": {
        "type": "string",
        "description": "Associated pickup request ID"
      },
      "customer_id": {
        "type": "string",
        "description": "Customer making payment"
      },
      "amount": {
        "type": "number",
        "description": "Payment amount in GHS"
      },
      "provider": {
        "type": "string",
        "enum": [
          "paystack",
          "cash"
        ],
        "default": "paystack",
        "description": "Payment provider used"
      },
      "channel": {
        "type": "string",
        "enum": [
          "mtn_momo",
          "vodafone_cash",
          "airteltigo_money"
        ],
        "description": "Specific mobile money channel"
      },
      "phone_number": {
        "type": "string",
        "description": "Mobile money phone number"
      },
      "transaction_id": {
        "type": "string",
        "description": "Paystack transaction reference"
      },
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "processing",
          "completed",
          "failed",
          "cancelled",
          "refunded"
        ],
        "default": "pending",
        "description": "Payment status"
      },
      "payment_date": {
        "type": "string",
        "format": "date-time",
        "description": "When payment was made"
      },
      "retry_count": {
        "type": "number",
        "default": 0,
        "description": "Number of retry attempts"
      },
      "failure_reason": {
        "type": "string",
        "description": "Reason for payment failure"
      },
      "receipt_url": {
        "type": "string",
        "description": "URL to payment receipt"
      }
    },
    "required": [
      "pickup_id",
      "customer_id",
      "amount"
    ],
    "rls": {
      "read": {
        "customer_id": "{{user.id}}"
      },
      "write": {
        "$or": [
          {
            "customer_id": "{{user.id}}"
          },
          {
            "user_condition": {
              "role": "admin"
            }
          }
        ]
      }
    }
  }