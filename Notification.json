{
    "name": "Notification",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "Notification title"
      },
      "message": {
        "type": "string",
        "description": "Notification message content"
      },
      "type": {
        "type": "string",
        "enum": [
          "new_pickup",
          "payment_received",
          "user_registered",
          "system_update"
        ],
        "description": "Type of notification"
      },
      "recipient_user_type": {
        "type": "string",
        "enum": [
          "administrator",
          "waste_collector",
          "all"
        ],
        "description": "Target user type for this notification"
      },
      "is_read": {
        "type": "boolean",
        "default": false,
        "description": "Whether notification has been read"
      },
      "link_to": {
        "type": "string",
        "description": "URL to navigate to when clicked"
      }
    },
    "required": [
      "title",
      "message",
      "type",
      "recipient_user_type"
    ],
    "rls": {
      "read": {
        "$or": [
          {
            "recipient_user_type": "all"
          },
          {
            "recipient_user_type": "{{user.data.user_type}}"
          },
          {
            "user_condition": {
              "role": "admin"
            }
          }
        ]
      },
      "write": {
        "user_condition": {
          "role": "admin"
        }
      }
    }
  }